<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <TargetFramework>net10.0-android</TargetFramework><OutputType>Exe</OutputType>
  <ApplicationId>app.boardlens.companion</ApplicationId><ApplicationTitle>BoardLens</ApplicationTitle>
  <ApplicationVersion>14</ApplicationVersion><ApplicationDisplayVersion>1.8.4</ApplicationDisplayVersion>
  <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion><TargetPlatformVersion>36.0</TargetPlatformVersion>
  <RuntimeIdentifier>android-arm64</RuntimeIdentifier><ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  <EnableDefaultCompileItems>false</EnableDefaultCompileItems><AndroidGenerateJavaClass>true</AndroidGenerateJavaClass>
  <AndroidManifest>../app/src/main/AndroidManifest.xml</AndroidManifest><AndroidPackageFormat>apk</AndroidPackageFormat>
  <RunAOTCompilation>false</RunAOTCompilation><AndroidLinkMode>None</AndroidLinkMode><EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  <JavacSourceVersion>17</JavacSourceVersion><JavacTargetVersion>17</JavacTargetVersion><AndroidUseDesignerAssembly>true</AndroidUseDesignerAssembly>
 </PropertyGroup>
 <ItemGroup>
  <Compile Include="Core/**/*.cs"/><Compile Include="Bots/*.cs"/><Compile Include="TinyCore.cs"/><Compile Include="TinyRuntime.cs"/>
  <AndroidJavaSource Include="../app/src/main/java/**/*.java" Bind="false"/>
  <AndroidResource Include="../app/src/main/res/**/*"><Link>Resources/%(RecursiveDir)%(Filename)%(Extension)</Link></AndroidResource>
  <AndroidAsset Include="../app/src/main/assets/**/*"><Link>Assets/%(RecursiveDir)%(Filename)%(Extension)</Link></AndroidAsset>
  <AndroidNativeLibrary Include="../app/src/main/jniLibs/arm64-v8a/*.so"/>
  <AndroidMavenLibrary Include="com.microsoft.onnxruntime:onnxruntime-android" Version="1.24.3" Bind="false"/>
  <AndroidMavenLibrary Include="org.jetbrains.kotlin:kotlin-stdlib-jdk8" Version="1.5.20" Bind="false"/>
  <AndroidMavenLibrary Include="org.jetbrains.kotlin:kotlin-stdlib-jdk7" Version="1.5.20" Bind="false"/>
  <AndroidMavenLibrary Include="org.jetbrains.kotlin:kotlin-stdlib" Version="1.5.20" Bind="false"/>
  <AndroidMavenLibrary Include="org.jetbrains.kotlin:kotlin-stdlib-common" Version="1.5.20" Bind="false"/>
  <AndroidMavenLibrary Include="org.jetbrains:annotations" Version="13.0" Bind="false"/>
  <AndroidMavenLibrary Include="org.opencv:opencv" Version="4.12.0" Bind="false"/>
 </ItemGroup>
</Project>
